NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/bigi_hub
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
ADMIN_ORIGINS=http://localhost:5174
# Render production settings (replace the development values above):
# CORS_ORIGINS=https://bigihub.netlify.app,https://bigihubadmin.netlify.app
# ADMIN_ORIGINS=https://bigihubadmin.netlify.app
# CORS_ORIGINS=https://bigihubadmin.netlify.app
# Generate a random secret of at least 32 characters. Required in production.
ADMIN_JWT_SECRET=
# Set both to provision the first admin, then remove them after provisioning.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
# AI Post Assistant: backend only. No key is exposed to Vite.
GEMINI_API_KEY=
# Must support image inputs and structured outputs.
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional sports collection: The News API key, backend only. Never use a VITE_ variable.
THE_NEWS_API_KEY=
